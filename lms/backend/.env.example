NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://amitcode8_db_user:wXCFVWnIzbCMOeab@cluster0.mhyydv2.mongodb.net/
JWT_SECRET=replace_with_a_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=1d
# Frontend URL(s), comma separated if more than one
CLIENT_URL=http://localhost:3000

# First admin (used by: npm run seed)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@lms.com
ADMIN_PASSWORD=Admin@12345

# ---- Classes & attendance rules ----
JOIN_EARLY_MINUTES=10        # students can join this many minutes before start
REMINDER_MINUTES=30          # email reminder is sent this long before start
ATTEND_MIN_PERCENT=75        # % of class time a student must stay to be counted present
PASS_PERCENT=0               # 0 = assignment counts when submitted; 50 = must be graded and score >= 50%
RUN_JOBS=true                # set false on extra instances so reminders run only once

# ---- Video (Jitsi) ----
# Public meet.jit.si limits embedded calls to a few minutes. For real classes use ONE of:
#  (a) your own Jitsi server:  JITSI_DOMAIN=meet.yourcollege.com
#  (b) 8x8 JaaS (managed Jitsi): fill the three JAAS_* values below
JITSI_DOMAIN=meet.jit.si
JAAS_APP_ID=
JAAS_KID=
JAAS_PRIVATE_KEY=

# ---- AWS S3 (assignment files, study material, class recordings) ----
AWS_REGION=ap-south-1
S3_BUCKET=
# Credentials: use an IAM role in production, or set these for local dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Email (Nodemailer / SMTP). Leave SMTP_HOST empty to only log emails to console ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GSN Foundation <no-reply@yourdomain.com>
